{
  "name": "codementor-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CodeMentor — 嵌入 AI 编程工作流的工程认知学习系统",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@8.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:vscode": "pnpm --filter codementor build && node apps/vscode/dist/test/run-test.js",
    "package:vscode": "pnpm --filter codementor package"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.6",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4",
    "zod": "^3.23.8"
  }
}
