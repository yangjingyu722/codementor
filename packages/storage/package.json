{
  "name": "@codementor/storage",
  "version": "0.1.0",
  "description": "CodeMentor SQLite 存储层：契约实体的持久化、索引与版本化迁移",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
