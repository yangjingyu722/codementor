  },
  "dependencies": {
    "@codementor/contracts": "workspace:*",
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "typescript": "^5.6.3"
  }
}
